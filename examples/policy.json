    "targets": [
      {
        "namespace": "mail",
        "action": "assess-sender-domain",
        "mode": "enforce",
        "schema": "mail/assess-sender-domain/v1",
        "domain_plan": "mail/domain_age",
        "default_policy": "mail/assess-sender-domain",
        "plans": {
          "final_decision": {
            "policy_sets": [
              "mail/assess-sender-domain"
            ]
          }
        },
        "no_match": "deny",
        "timeouts": {
          "evaluation": "3s",
          "provider_default": "2s"
        }
      },
